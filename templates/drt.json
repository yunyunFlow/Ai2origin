{
  "schema_version": 1,
  "style": {
    "marker": {
      "size_pt": 2.5
    }
  },
  "plots": [
    {
      "id": "drt",
      "kind": "line_symbol",
      "csv": "drt.csv",
      "x": "tau",
      "series": [
        {
          "column": "a",
          "label": "A"
        },
        {
          "column": "b",
          "label": "B"
        }
      ],
      "synthetic": true,
      "title": "",
      "labels": {
        "x": "Relaxation time, τ (s)",
        "y": "γ(τ) (a.u.)"
      },
      "x_scale": "log10",
      "x_range": [
        0.001,
        100000.0
      ],
      "caption": "Invented A/B gamma curves: 81 positive τ nodes from 10^-3 to 10^5 s, true log10 X axis. No EIS inversion, regularization or process assignment."
    },
    {
      "id": "drt-stack",
      "kind": "line_symbol",
      "csv": "drt.csv",
      "x": "tau",
      "series": [
        {
          "column": "a",
          "label": "A"
        },
        {
          "column": "b",
          "label": "B",
          "offset": 1
        }
      ],
      "synthetic": true,
      "title": "",
      "labels": {
        "x": "Relaxation time, τ (s)",
        "y": "γ(τ) + offset (a.u.)"
      },
      "x_scale": "log10",
      "x_range": [
        0.001,
        100000.0
      ],
      "caption": "Invented A/B gamma curves: 81 positive τ nodes from 10^-3 to 10^5 s, true log10 X axis. No EIS inversion, regularization or process assignment. Display offsets 0/1 a.u.; raw values retained."
    },
    {
      "id": "drt-map",
      "kind": "heatmap",
      "csv": "drt-map.csv",
      "x": "toy_tau",
      "y": "toy_condition",
      "z": "toy_gamma",
      "synthetic": true,
      "title": "",
      "labels": {
        "x": "Relaxation time, τ (s)",
        "y": "Condition index (synthetic)",
        "color": "γ(τ) (a.u.)"
      },
      "color_range": [
        0,
        1
      ],
      "center": 0.5,
      "color_levels": 256,
      "cmap": [
        "#2166AC",
        "#F7F7F7",
        "#B2182B"
      ],
      "interpolation": {
        "method": "bilinear",
        "factor": 8
      },
      "x_scale": "log10",
      "x_range": [
        0.001,
        100000.0
      ],
      "caption": "Invented 9x81 condition/τ nodes. Display-only bilinear interpolation in log10(τ),condition, factor 8: 65x641 display nodes, 256 blue-white-red levels, [0,1], white=0.5. Raw nodes retained; no new observations, denoising, physical resolution or EIS inversion."
    }
  ]
}
