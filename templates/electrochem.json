{
  "schema_version": 1,
  "style": {
    "marker": {
      "size_pt": 2.5
    }
  },
  "plots": [
    {
      "id": "cv",
      "kind": "line",
      "csv": "electrochem.csv",
      "x": "potential",
      "series": [
        {
          "column": "current_a",
          "label": "A"
        },
        {
          "column": "current_b",
          "label": "B"
        }
      ],
      "synthetic": true,
      "title": "",
      "labels": {
        "x": "Potential (V)",
        "y": "Current (mA)"
      },
      "connect_order": "acquisition",
      "caption": "Synthetic A/B current-potential loops, 129 ordered samples each, V and mA. Acquisition order and turning points retained; voltage reference is arbitrary. No scan-rate, kinetic or capacitance inference."
    },
    {
      "id": "gcd",
      "kind": "line",
      "csv": "electrochem.csv",
      "x": "capacity",
      "series": [
        {
          "column": "voltage",
          "label": "cycle"
        }
      ],
      "synthetic": true,
      "title": "",
      "labels": {
        "x": "Capacity (mAh g^-1)",
        "y": "Voltage (V)"
      },
      "connect_order": "acquisition",
      "caption": "Synthetic charge/discharge display loop, 129 ordered samples, capacity in mAh/g and voltage in V. Capacity is a toy mass-specific quantity; no experimental active mass, current or efficiency is implied."
    },
    {
      "id": "cycling",
      "kind": "line_symbol",
      "csv": "electrochem.csv",
      "x": "cycle",
      "series": [
        {
          "column": "retention",
          "label": "retention"
        }
      ],
      "synthetic": true,
      "title": "",
      "labels": {
        "x": "Cycle",
        "y": "Retention (percent)"
      },
      "caption": "Synthetic retention for cycles 1-129, in percent. One assigned curve, no replicate uncertainty or lifetime extrapolation."
    },
    {
      "id": "nyquist",
      "kind": "line_symbol",
      "csv": "electrochem.csv",
      "x": "zreal",
      "series": [
        {
          "column": "znegimag",
          "label": "arc"
        }
      ],
      "synthetic": true,
      "title": "",
      "labels": {
        "x": "Z′ (Ω)",
        "y": "−Z″ (Ω)"
      },
      "connect_order": "acquisition",
      "x_range": [
        0,
        30
      ],
      "y_range": [
        0,
        30
      ],
      "x_tick_step": 5,
      "y_tick_step": 5,
      "equal_xy": true,
      "caption": "Invented 129-point impedance arc. Both axes span 0–30 Ω, major ticks 5 Ω and equal physical scale; square frame. No circuit fit or charge-transfer interpretation."
    },
    {
      "id": "gcd-time",
      "kind": "line",
      "csv": "gcd-time.csv",
      "x": "time",
      "series": [
        {
          "column": "voltage_a",
          "label": "A"
        },
        {
          "column": "voltage_b",
          "label": "B"
        }
      ],
      "synthetic": true,
      "title": "",
      "labels": {
        "x": "time (s)",
        "y": "voltage (V)"
      },
      "caption": "Invented triangular charge/discharge-time profiles A/B, 201 samples in seconds and volts. Arbitrary voltage reference; no measured capacity or cycling efficiency."
    },
    {
      "id": "gitt",
      "kind": "line",
      "csv": "pulses.csv",
      "x": "time",
      "series": [
        {
          "column": "voltage",
          "label": "pulses"
        }
      ],
      "synthetic": true,
      "title": "",
      "labels": {
        "x": "time (s)",
        "y": "voltage (V)"
      },
      "caption": "Invented pulse/rest voltage trace, 241 samples, 30-second toy pulses within 200-second periods; current stored separately. No experimental GITT, iR correction, diffusion fit or diffusion coefficient."
    },
    {
      "id": "cycle-capacity",
      "kind": "line_symbol",
      "csv": "performance.csv",
      "x": "cycle",
      "series": [
        {
          "column": "capacity_a",
          "label": "A"
        },
        {
          "column": "capacity_b",
          "label": "B"
        }
      ],
      "synthetic": true,
      "title": "",
      "labels": {
        "x": "cycle",
        "y": "capacity (mAh g^-1)"
      },
      "y_tick_step": 5,
      "caption": "Invented A/B mass-specific capacity histories over 129 toy cycles. No experiment, active-mass measurement, error estimate or extrapolation."
    },
    {
      "id": "coulombic",
      "kind": "line_symbol",
      "csv": "performance.csv",
      "x": "cycle",
      "series": [
        {
          "column": "ce_a",
          "label": "A"
        },
        {
          "column": "ce_b",
          "label": "B"
        }
      ],
      "synthetic": true,
      "title": "",
      "labels": {
        "x": "cycle",
        "y": "CE (percent)"
      },
      "caption": "Invented A/B CE-shaped curves over 129 toy cycles, percent. Values assigned directly, not calculated from measured charge/discharge integrals."
    },
    {
      "id": "rate",
      "kind": "line_symbol",
      "csv": "rate.csv",
      "x": "cycle",
      "series": [
        {
          "column": "capacity",
          "label": "steps"
        }
      ],
      "synthetic": true,
      "title": "",
      "labels": {
        "x": "cycle",
        "y": "capacity (mAh g^-1)"
      },
      "x_tick_step": 5,
      "caption": "Invented four-cycle blocks with assigned capacity steps 150/136/110/85/108/134 mAh/g. Toy rate schedule 1/2/5/10/5/2; no experimental rate-performance conclusion."
    },
    {
      "id": "bode-magnitude",
      "kind": "line",
      "csv": "bode.csv",
      "x": "frequency",
      "series": [
        {
          "column": "magnitude",
          "label": "magnitude"
        }
      ],
      "synthetic": true,
      "title": "",
      "labels": {
        "x": "Frequency (Hz)",
        "y": "|Z| (Ω)"
      },
      "y_tick_step": 5,
      "x_scale": "log10",
      "x_range": [
        0.01,
        100000.0
      ],
      "caption": "Invented complex-impedance function at 121 actual positive frequency nodes; true log10 frequency axis, not a fit. Independent of toy Nyquist/DRT."
    },
    {
      "id": "bode-phase",
      "kind": "line",
      "csv": "bode.csv",
      "x": "frequency",
      "series": [
        {
          "column": "phase",
          "label": "phase"
        }
      ],
      "synthetic": true,
      "title": "",
      "labels": {
        "x": "Frequency (Hz)",
        "y": "phase (°)"
      },
      "x_scale": "log10",
      "x_range": [
        0.01,
        100000.0
      ],
      "caption": "Invented complex-impedance function at 121 actual positive frequency nodes; true log10 frequency axis, not a fit. Independent of toy Nyquist/DRT."
    }
  ]
}
